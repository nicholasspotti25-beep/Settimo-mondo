{
  "name": "settimo-mondo",
  "private": true,
  "version": "1.0.0",
  "description": "Settimo Mondo — boss-only action RPG for phones and tablets (offline PWA + Capacitor).",
  "type": "module",
  "scripts": {
    "data": "tsx tools/build-data.ts",
    "registry": "tsx tools/gen-registry.ts",
    "prebuild": "npm run registry && npm run data",
    "predev": "npm run registry && npm run data",
    "dev": "vite --host",
    "build": "vite build && tsx tools/gen-sw.ts",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src tools tests",
    "test": "vitest run",
    "bot": "tsx tools/balance-bot.ts",
    "audit": "tsx tools/canon-audit.ts",
    "smoke": "tsx tools/smoke.ts",
    "check": "npm run registry && npm run data && npm run typecheck && npm run lint && npm run test && npm run audit && npm run bot",
    "cap:sync": "npm run build && npx cap sync",
    "cap:android": "npm run cap:sync && npx cap open android",
    "cap:ios": "npm run cap:sync && npx cap open ios"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/screen-orientation": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "eslint": "9.39.5",
    "playwright-core": "1.56.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "4.1.11",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
